# Chesstoire Backend Environment Variables
# Copy this file to .env and fill in the values

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://chesstoire:chesstoire_dev@localhost:5432/chesstoire

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# External APIs
ANTHROPIC_API_KEY=your-anthropic-api-key

# Chess.com API (no auth needed for public data)
CHESSCOM_API_BASE_URL=https://api.chess.com/pub

# Lichess API
LICHESS_API_BASE_URL=https://lichess.org/api
LICHESS_API_TOKEN=your-lichess-token-optional

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
